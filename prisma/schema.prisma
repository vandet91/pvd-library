generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          Role      @default(MEMBER)
  image         String?
  // Per-user preferences
  theme         String?   // "ocean"|"midnight"|"emerald"  — null = use library default
  authStyle     String?   // "split"|"glass"|"minimal"     — null = use library default
  authMethods   String    @default("[\"password\",\"google\",\"magic\"]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  member           Member?
  accounts         Account[]
  sessions         Session[]
  assignedTasks    StaffTask[]     @relation("TaskAssignee")
  queryTemplates   QueryTemplate[] @relation("QueryTemplateAuthor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Member {
  id           String        @id @default(cuid())
  memberId     String        @unique
  userId       String?       @unique
  name         String
  email        String?       @unique
  phone        String?
  address      String?
  memberType   MemberType    @default(STUDENT)
  gender       Gender        @default(UNSPECIFIED)
  joinDate     DateTime      @default(now())
  expireDate   DateTime?
  isActive            Boolean            @default(true)
  pendingApproval     Boolean            @default(false)
  // Restriction / discipline
  restrictionStatus   MemberRestriction  @default(NONE)
  restrictionReason   String?            @db.Text
  restrictedAt        DateTime?
  restrictedBy        String?            // staff name who applied it
  restrictionExpiry   DateTime?          // null = permanent; set for timed suspensions
  studentId           String?
  school              String?
  className           String?
  telegramChatId      String?       @unique
  telegramLinkedAt    DateTime?
  telegramLinkCode    String?       @unique
  telegramLinkExpiry  DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User?         @relation(fields: [userId], references: [id])
  loans               Loan[]
  fines               Fine[]
  reservations        Reservation[]
  bookRequests        BookRequest[]
  ratings             Rating[]
  incidents           MemberIncident[]
  basketItems         BasketItem[]
  saleCart            SaleCart?
  saleOrders          SaleOrder[]

  @@index([restrictionStatus])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  nameKm    String?
  createdAt DateTime @default(now())
  books     Book[]
  ebooks    Ebook[]
}

model Author {
  id              String   @id @default(cuid())
  name            String
  createdAt       DateTime @default(now())
  books           Book[]
  coAuthoredBooks Book[]   @relation("BookCoAuthors")
  ebooks          Ebook[]
  basketItems     BasketItem[]
}

model Publisher {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  books     Book[]
}

model Location {
  id          String   @id @default(cuid())
  name        String   @unique         // shelf code, e.g. "A-12", "REF-2"
  description String?                  // human-readable label, e.g. "Reference Section, 2nd floor"
  createdAt   DateTime @default(now())
  books       Book[]
}

model Branch {
  id        String     @id @default(cuid())
  name      String     @unique
  nameKm    String?
  address   String?
  phone     String?
  email     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  books          Book[]
  copies         BookCopy[]
  loans          Loan[]
  movementsFrom     StockMovement[]    @relation("MovementFrom")
  movementsTo       StockMovement[]    @relation("MovementTo")
  saleOrders        SaleOrder[]        @relation("SaleOrderBranch")
  circulationRules  CirculationRule[]
}

model Book {
  id              String        @id @default(cuid())
  title           String
  titleKm         String?
  subtitle        String?
  edition         String?
  isbn            String?       @unique
  barcode         String?       @unique
  description     String?       @db.Text
  coverImage      String?
  publishYear     Int?
  pages           Int?
  language        String?       @default("en")
  callNumber      String?
  location        String?
  pmbNoticeId     Int?          // temporary: PMB notice_id for loan migration
  totalCopies     Int           @default(1)
  availableCopies Int           @default(1)
  materialType    MaterialType  @default(BOOK)
  audienceLevel   AudienceLevel @default(UNSPECIFIED)
  condition       BookCondition @default(GOOD)
  price           Float?
  referenceOnly   Boolean       @default(false)  // title-level: all copies are in-library only
  withdrawnAt     DateTime?
  withdrawnReason String?
  lastInventoryAt DateTime?
  categoryId      String?
  authorId        String?
  publisherId     String?
  locationId      String?
  branchId        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  category        Category?     @relation(fields: [categoryId], references: [id])
  author          Author?       @relation(fields: [authorId], references: [id])
  coAuthors       Author[]      @relation("BookCoAuthors")
  publisher       Publisher?    @relation(fields: [publisherId], references: [id])
  shelfLocation   Location?     @relation(fields: [locationId], references: [id])
  branch          Branch?       @relation(fields: [branchId], references: [id])
  loans           Loan[]
  reservations    Reservation[]
  ebooks          Ebook[]
  inventoryItems  InventoryItem[]
  basketItems     BasketItem[]
  copies          BookCopy[]
  ratings         Rating[]
  stockMovements  StockMovement[]
  saleCartItems      SaleCartItem[]
  saleOrderItems     SaleOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([title])
  @@index([categoryId])
  @@index([authorId])
  @@index([materialType])
  @@index([availableCopies])
  @@index([createdAt])
}

model Loan {
  id           String     @id @default(cuid())
  memberId     String
  bookId       String
  copyId       String?    // specific physical copy borrowed (NULL = legacy loan)
  loanType     LoanType   @default(HOME)
  borrowDate   DateTime   @default(now())
  dueDate      DateTime
  returnDate   DateTime?
  status       LoanStatus @default(ACTIVE)
  renewalCount Int        @default(0)
  branchId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  member       Member     @relation(fields: [memberId], references: [id])
  book         Book       @relation(fields: [bookId], references: [id])
  copy         BookCopy?  @relation(fields: [copyId], references: [id])
  branch       Branch?    @relation(fields: [branchId], references: [id])
  fines        Fine[]

  @@index([status])
  @@index([memberId])
  @@index([bookId])
  @@index([copyId])
  @@index([dueDate])
  @@index([status, dueDate])
}

model BookCopy {
  id          String        @id @default(cuid())
  bookId      String
  copyNumber  Int           // 1, 2, 3, ... unique per book
  barcode      String?       @unique
  rfid         String?       @unique
  pmbId              Int?     // PMB exemplaire_id
  pmbOriginalBarcode String?  // original PMB expl_cb — for lookup when member returns with old label
  condition    BookCondition @default(GOOD)
  status       CopyStatus    @default(AVAILABLE)
  loanable     Boolean       @default(true)   // false = in-library only (reference, rare, etc.)
  labelPrinted Boolean       @default(false)  // true once spine label has been printed
  acquiredAt   DateTime      @default(now())
  price       Float?
  notes       String?       @db.Text
  branchId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  book           Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id])
  loans          Loan[]
  basketItems    BasketItem[]
  reservations   Reservation[]
  stockMovements StockMovement[]
  saleCartItem   SaleCartItem?
  saleOrderItems SaleOrderItem[]

  @@unique([bookId, copyNumber])
  @@index([bookId])
  @@index([status])
  @@index([condition])
}

enum CopyStatus {
  STOCK         // received but not yet deployed to a branch / shelf
  AVAILABLE
  FOR_SALE      // pulled from stock and listed for purchase by members
  BORROWED
  RESERVED
  SOLD          // successfully sold to a member
  LOST
  DAMAGED
  WITHDRAWN
}

// ─── Stock Movement (audit trail for every copy state change) ──────────────
model StockMovement {
  id           String            @id @default(cuid())
  copyId       String
  bookId       String            // denormalised — survives copy deletion
  type         StockMovementType
  fromStatus   CopyStatus?
  toStatus     CopyStatus
  fromBranchId String?
  toBranchId   String?
  source       String?           // PURCHASE | DONATION | TRANSFER | RETURN | MANUAL
  reference    String?           // PO / invoice / donation reference number
  unitCost     Float?            // purchase cost per copy (for accounting)
  currency     String?           @default("USD")
  notes        String?           @db.Text
  actorId      String?
  actorName    String?
  createdAt    DateTime          @default(now())

  copy       BookCopy @relation(fields: [copyId],       references: [id], onDelete: Cascade)
  book       Book     @relation(fields: [bookId],       references: [id], onDelete: Cascade)
  fromBranch Branch?  @relation("MovementFrom",         fields: [fromBranchId], references: [id])
  toBranch   Branch?  @relation("MovementTo",           fields: [toBranchId],   references: [id])

  @@index([copyId])
  @@index([bookId])
  @@index([type])
  @@index([createdAt])
}

enum StockMovementType {
  RECEIVED           // new copy added to stock (purchase / donation)
  DEPLOYED           // stock → available at branch for lending
  DEPLOYED_FOR_SALE  // stock → for sale
  TRANSFERRED        // branch → branch (no status change)
  RETURNED_TO_STOCK  // branch → back to central stock
  WITHDRAWN          // permanently removed from circulation
  STATUS_CHANGE      // manual status correction by staff
  SOLD               // copy sold to member  (populated in Phase 2)
  SALE_RETURNED      // returned from sale   (populated in Phase 4)
}

model Fine {
  id            String     @id @default(cuid())
  loanId        String
  memberId      String
  amount        Float
  daysLate      Int        @default(0)
  type          FineType   @default(LATE_FEE)
  status        FineStatus @default(UNPAID)
  paidAt        DateTime?
  paymentMethod String?    // "cash" | "bank_transfer" | "online" | "waived" | "other"
  notes         String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  loan          Loan       @relation(fields: [loanId], references: [id])
  member        Member     @relation(fields: [memberId], references: [id])

  @@index([loanId])
  @@index([status])
  @@index([memberId])
  @@index([type])
}

model Ebook {
  id          String    @id @default(cuid())
  title       String
  titleKm     String?
  description String?   @db.Text
  ebookType   EbookType
  fileUrl     String
  coverImage  String?
  language    String?   @default("en")
  publishYear Int?
  categoryId  String?
  authorId    String?
  bookId      String?
  isPublic    Boolean   @default(true)
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id])
  author      Author?   @relation(fields: [authorId], references: [id])
  book        Book?     @relation(fields: [bookId], references: [id])
  ratings     Rating[]
  basketItems BasketItem[]

  @@index([categoryId])
  @@index([authorId])
  @@index([ebookType])
  @@index([views])
}

model Rating {
  id        String   @id @default(cuid())
  memberId  String
  bookId    String?
  ebookId   String?
  score     Int      // 1–5
  review    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  book   Book?   @relation(fields: [bookId],  references: [id], onDelete: Cascade)
  ebook  Ebook?  @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@unique([memberId, bookId])
  @@unique([memberId, ebookId])
  @@index([bookId])
  @@index([ebookId])
  @@index([memberId])
}

model Reservation {
  id        String            @id @default(cuid())
  memberId  String
  bookId    String
  copyId    String?           // specific copy pulled to hold shelf when READY (NULL until then)
  status    ReservationStatus @default(PENDING)
  note      String?
  holdShelf String?           // where the book is placed when READY (e.g. "Hold Shelf A")
  expiresAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  member    Member            @relation(fields: [memberId], references: [id])
  book      Book              @relation(fields: [bookId], references: [id])
  copy      BookCopy?         @relation(fields: [copyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([memberId])
  @@index([bookId])
  @@index([copyId])
  @@index([expiresAt])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model BookRequest {
  id        String             @id @default(cuid())
  memberId  String
  title     String
  author    String?
  isbn      String?
  notes     String?            @db.Text
  status    BookRequestStatus  @default(PENDING)
  adminNote String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  member    Member             @relation(fields: [memberId], references: [id])

  @@index([status])
  @@index([memberId])
}

enum Role {
  ADMIN
  LIBRARIAN
  STAFF
  MEMBER
}

enum MemberType {
  STUDENT
  TEACHER
  STAFF
  PUBLIC
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum LoanType {
  HOME
  IN_LIBRARY
}

enum FineStatus {
  UNPAID
  PAID
  WAIVED
}

enum FineType {
  LATE_FEE
  REPLACEMENT
  DAMAGED
}

enum MemberRestriction {
  NONE
  IN_LIBRARY_ONLY  // home loans blocked; can borrow in-library
  SUSPENDED        // all borrowing blocked; can still log in
  BLOCKED          // login blocked (temporary — has expiry)
  BLACKLISTED      // login blocked permanently; admin override required
}

model MemberIncident {
  id          String       @id @default(cuid())
  memberId    String
  type        IncidentType
  description String       @db.Text
  severity    Int          @default(1)   // 1 = minor, 2 = moderate, 3 = serious
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?      @db.Text
  actorName   String?      // staff who logged it
  createdAt   DateTime     @default(now())
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([type])
}

enum IncidentType {
  BOOK_DAMAGE
  BOOK_LOST
  REPEATED_LATE
  BEHAVIORAL
  POLICY_VIOLATION
  OTHER
}

enum ReservationStatus {
  PENDING
  APPROVED
  READY       // book pulled from shelf and placed in hold area
  CANCELLED
  FULFILLED
  EXPIRED
}

enum EbookType {
  PDF
  EPUB
  LINK
  VIDEO
  AUDIO
}

enum BookRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum AudienceLevel {
  CHILDREN
  YOUTH
  ADULTS
  UNSPECIFIED
}

enum MaterialType {
  BOOK
  MAGAZINE
  JOURNAL
  NEWSPAPER
  DVD
  AUDIO_CD
  THESIS
  MAP
  OTHER
}

enum BookCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
  LOST
  WITHDRAWN
  ARCHIVED
}

model Inventory {
  id          String          @id @default(cuid())
  name        String
  notes       String?         @db.Text
  status      InventoryStatus @default(ACTIVE)
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       InventoryItem[]
}

model InventoryItem {
  id          String    @id @default(cuid())
  inventoryId String
  bookId      String
  scannedAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  book        Book      @relation(fields: [bookId], references: [id])

  @@unique([inventoryId, bookId])
}

enum InventoryStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Notification {
  id            String             @id @default(cuid())
  type          NotificationType
  memberId      String
  loanId        String?
  reservationId String?
  recipient     String             // email address it was sent to
  subject       String
  status        NotificationStatus @default(PENDING)
  error         String?            @db.Text
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  @@index([memberId])
  @@index([loanId])
  @@index([reservationId])
  @@index([type, sentAt])
  @@index([status])
}

enum NotificationType {
  DUE_SOON
  OVERDUE
  RESERVATION_READY
  TEST
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String   // e.g. "member.approved", "loan.checkout", "book.deleted"
  entityType String   // "Member" | "Book" | "Loan" | "Fine" | "Reservation" | "Settings"
  entityId   String?
  entityName String?  // denormalized — readable even after the record is deleted
  actorId    String?  // User.id (null = system / cron / self-registration)
  actorName  String?
  actorRole  String?
  detail     Json?    // { before: {...}, after: {...} }  or free-form extra context
  ip         String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum BasketType {
  ITEM    // physical book copies
  EBOOK   // digital resources / e-books
  AUTHOR  // author records
  MEMBER  // member records
}

model Basket {
  id         String     @id @default(cuid())
  name       String
  basketType BasketType @default(ITEM)
  notes      String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      BasketItem[]
}

model BasketItem {
  id       String    @id @default(cuid())
  basketId String
  tagged   Boolean   @default(false)
  addedAt  DateTime  @default(now())

  // ITEM basket — physical copy (both required together)
  bookId   String?
  copyId   String?

  // EBOOK basket
  ebookId  String?

  // AUTHOR basket
  authorId String?

  // MEMBER basket
  memberId String?

  basket   Basket    @relation(fields: [basketId], references: [id], onDelete: Cascade)
  book     Book?     @relation(fields: [bookId],   references: [id], onDelete: Cascade)
  copy     BookCopy? @relation(fields: [copyId],   references: [id], onDelete: Cascade)
  ebook    Ebook?    @relation(fields: [ebookId],  references: [id], onDelete: Cascade)
  author   Author?   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  member   Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([basketId, copyId])
  @@unique([basketId, ebookId])
  @@unique([basketId, authorId])
  @@unique([basketId, memberId])
  @@index([bookId])
  @@index([ebookId])
  @@index([authorId])
  @@index([memberId])
}

// ─── Sale / Bookshop ─────────────────────────────────────────────────────────

model SaleCart {
  id        String         @id @default(cuid())
  memberId  String         @unique   // one cart per member
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items     SaleCartItem[]
}

model SaleCartItem {
  id      String   @id @default(cuid())
  cartId  String
  copyId  String   @unique   // one copy can only sit in one cart at a time
  bookId  String
  addedAt DateTime @default(now())
  cart    SaleCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  copy    BookCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([cartId, copyId])
  @@index([cartId])
  @@index([bookId])
}

model SaleOrder {
  id            String           @id @default(cuid())
  orderNumber   String           @unique  // e.g. "SO-2025-0001"
  memberId      String?                   // null for walk-in / counter sales
  status        SaleOrderStatus  @default(PENDING_PAYMENT)
  deliveryType  SaleDeliveryType @default(PICKUP)

  // Sale channel
  saleChannel   String  @default("ONLINE")  // "ONLINE" | "COUNTER"
  walkInName    String?                      // customer name for counter sales
  walkInPhone   String?                      // customer phone for counter sales

  // Delivery / pickup
  deliveryAddress String?  @db.Text  // filled when DELIVERY
  branchId        String?            // filled when PICKUP

  // Payment
  paymentMethod String?   // "qr" | "card" | "cash_on_pickup" | "cash" | "card_counter"
  paymentProof  String?   // uploaded image URL (screenshot of QR payment)
  paymentRef    String?   // transaction / reference ID from payment
  paidAt        DateTime?

  // Financials (snapshot at checkout time)
  subtotal    Float
  shippingFee Float  @default(0)
  taxAmount   Float  @default(0)
  total       Float
  currency    String @default("USD")

  // Logistics (staff fills when SHIPPED)
  logisticsCompany String?
  trackingNumber   String?
  expectedDelivery DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?

  // Notes
  memberNote  String?  @db.Text
  staffNote   String?  @db.Text

  // Cancellation
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch?        @relation("SaleOrderBranch", fields: [branchId], references: [id])
  memberRel Member?        @relation(fields: [memberId], references: [id])
  items     SaleOrderItem[]

  @@index([memberId])
  @@index([status])
  @@index([saleChannel])
  @@index([createdAt])
}

model SaleOrderItem {
  id        String  @id @default(cuid())
  orderId   String
  copyId    String
  bookId    String
  unitPrice Float
  currency  String  @default("USD")

  order SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  copy  BookCopy  @relation(fields: [copyId], references: [id])
  book  Book      @relation(fields: [bookId], references: [id])

  @@unique([orderId, copyId])
  @@index([orderId])
  @@index([copyId])
  @@index([bookId])
}

enum SaleOrderStatus {
  PENDING_PAYMENT    // order created, awaiting payment
  PAYMENT_SUBMITTED  // member uploaded proof, awaiting staff confirmation
  PAYMENT_CONFIRMED  // staff confirmed payment received
  PREPARING          // staff is packaging the order
  READY_FOR_PICKUP   // ready at branch for member to collect
  SHIPPED            // dispatched with logistics info
  DELIVERED          // confirmed received by member
  COMPLETED          // fully closed
  CANCELLED          // cancelled by member or staff
  RETURN_REQUESTED   // member wants to return
  RETURNED           // physical item back with library
  REFUNDED           // refund processed
}

enum SaleDeliveryType {
  PICKUP    // member collects at a branch
  DELIVERY  // shipped to member's address
}

// ─── Staff Task Board ─────────────────────────────────────────────────────────

model StaffTask {
  id           String       @id @default(cuid())
  title        String                           // short, imperative verb phrase
  description  String?      @db.Text
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(PENDING)
  category     String?                          // overdue | reservations | acquisition | processing | members | other
  dueDate      DateTime?
  relatedId    String?                          // ID of linked entity (member, book, loan…)
  relatedType  String?                          // "member" | "book" | "loan" | "reservation"
  createdByAI  Boolean      @default(false)
  aiContext    String?      @db.Text            // AI message that spawned the task
  assignedToId String?
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdByAI])
  @@index([createdAt])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

// ─── Library Calendar ─────────────────────────────────────────────────────────

// Weekly opening schedule — one row per day of week (0=Sun … 6=Sat)
model LibraryHours {
  id        String  @id @default(cuid())
  dayOfWeek Int     @unique  // 0 = Sunday, 6 = Saturday
  isOpen    Boolean @default(true)
  openTime  String? // "08:00"
  closeTime String? // "17:00"
}

// Specific closed dates (holidays, special closures)
model ClosedDay {
  id          String   @id @default(cuid())
  date        DateTime @db.Date  // date only, no time
  reason      String?
  isRecurring Boolean  @default(false)  // true = recurs every year on this month/day
  createdAt   DateTime @default(now())

  @@unique([date])
  @@index([date])
}

// ─── Serials ──────────────────────────────────────────────────────────────────

model Serial {
  id            String         @id @default(cuid())
  title         String
  titleKm       String?
  issn          String?        @unique
  publisher     String?
  frequency     SerialFrequency @default(MONTHLY)
  language      String?        @default("en")
  description   String?        @db.Text
  coverImage    String?
  isActive      Boolean        @default(true)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  issues        SerialIssue[]

  @@index([isActive])
  @@index([frequency])
}

model Subscription {
  id           String             @id @default(cuid())
  serialId     String
  vendorId     String?
  startDate    DateTime
  endDate      DateTime?
  cost         Float?
  currency     String             @default("USD")
  autoRenew    Boolean            @default(false)
  notes        String?            @db.Text
  status       SubscriptionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  serial       Serial             @relation(fields: [serialId], references: [id], onDelete: Cascade)
  vendor       Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([serialId])
  @@index([status])
  @@index([endDate])
}

model SerialIssue {
  id           String      @id @default(cuid())
  serialId     String
  volume       String?     // e.g. "Vol. 12"
  issueNumber  String      // e.g. "No. 3", "March 2025"
  issueDate    DateTime    // cover date / publication date
  receivedDate DateTime?
  status       IssueStatus @default(EXPECTED)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  serial       Serial      @relation(fields: [serialId], references: [id], onDelete: Cascade)

  @@index([serialId])
  @@index([status])
  @@index([issueDate])
}

enum SerialFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  IRREGULAR
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum IssueStatus {
  EXPECTED   // predicted by schedule, not yet arrived
  RECEIVED   // arrived and checked in
  MISSING    // overdue and not received
  CLAIMED    // claim sent to vendor
  WITHDRAWN  // removed from collection
}

// ─── Acquisitions ─────────────────────────────────────────────────────────────

model Vendor {
  id        String          @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?         @db.Text
  website   String?
  notes     String?         @db.Text
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orders        PurchaseOrder[]
  subscriptions Subscription[]

  @@index([isActive])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  orderNumber  String              @unique   // e.g. "PO-2025-0001"
  vendorId     String
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  subtotal     Float               @default(0)
  currency     String              @default("USD")
  notes        String?             @db.Text
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  items        PurchaseOrderItem[]

  @@index([status])
  @@index([vendorId])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  bookId    String?       // null = new title not yet cataloged
  title     String        // snapshot at order time
  isbn      String?
  quantity  Int           @default(1)
  unitPrice Float         @default(0)
  currency  String        @default("USD")
  received  Int           @default(0)
  notes     String?
  createdAt DateTime      @default(now())
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book      Book?         @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([bookId])
}

enum PurchaseOrderStatus {
  DRAFT      // being prepared
  SENT       // sent to vendor, awaiting fulfillment
  PARTIAL    // some items received
  RECEIVED   // fully received
  CANCELLED
}

// ─── Circulation Rules Matrix ─────────────────────────────────────────────────
// Rules are resolved by specificity: memberType+materialType+branch wins over
// memberType+materialType, which wins over memberType-only, etc.
// Falls back to global Settings values when no rule matches.
model CirculationRule {
  id           String        @id @default(cuid())
  name         String                          // human-readable label, e.g. "Student – Magazine"
  memberType   MemberType?                     // null = all patron types
  materialType MaterialType?                   // null = all material types
  branchId     String?                         // null = all branches
  loanDays     Int           @default(14)
  maxLoans     Int           @default(3)
  maxRenewals  Int           @default(2)
  renewalDays  Int           @default(14)      // days added per renewal
  finePerDay   Float         @default(0.50)
  allowHomeLoan Boolean      @default(true)    // false = in-library only for this combination
  isActive     Boolean       @default(true)
  notes        String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  branch       Branch?       @relation(fields: [branchId], references: [id])

  @@index([memberType])
  @@index([materialType])
  @@index([branchId])
  @@index([isActive])
}

model QueryTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  sql         String   @db.Text
  createdById String?
  createdBy   User?    @relation("QueryTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

