# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/pvd_library"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (optional — for magic-link login and due-date notifications) ───────
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@example.com"
EMAIL_SERVER_PASSWORD="your-email-password"
EMAIL_FROM="library@example.com"

# ─── Google OAuth (optional — for Google login) ──────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI Book Search ───────────────────────────────────────────────────────────
# Switch providers by changing these 4 lines — zero code changes needed.
#
# Phase 1 — Gemini Flash FREE (1,500 searches/day)
#   Get key: aistudio.google.com → "Get API Key"
AI_PROVIDER=gemini
AI_API_KEY=AIza...
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
#
# Phase 2 — DeepSeek (paid, ~$1 per 1,000 searches, best value)
#   Get key: platform.deepseek.com
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
#
# Phase 3 — Claude Haiku (paid, ~$3 per 1,000 searches, best Khmer)
#   Get key: console.anthropic.com
# AI_PROVIDER=claude
# AI_API_KEY=sk-ant-...
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MODEL=claude-haiku-4-5

# ─── ISBN Lookup (optional — improves coverage for Asian / Khmer books) ───────
# Get key: isbndb.com → Sign up → API Keys  (free tier: 1 req/s)
# When set, ISBNdb is tried as source 4 before the OL Covers fallback.
NEXT_PUBLIC_ISBNDB_API_KEY=

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Create bot: open Telegram → @BotFather → /newbot
# Register webhook after deploy:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://yourdomain.com/api/telegram/webhook"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username_bot
# Optional: secret token to verify webhook requests come from Telegram
TELEGRAM_WEBHOOK_SECRET=
